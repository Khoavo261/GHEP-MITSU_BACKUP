static uint16_t Sensor_ReadDistance(uint8_t *p_status) {
    L0X_Wr(0x80, 0x01);
    L0X_Wr(0xFF, 0x01);
    L0X_Wr(0x00, 0x00);
    L0X_Wr(0x91, s_l0x_stop_variable);
    L0X_Wr(0x00, 0x01);
    L0X_Wr(0xFF, 0x00);
    L0X_Wr(0x80, 0x00);

    L0X_Wr(0x00, 0x01); // Kích hoạt phát xung Laser

    uint32_t start_tick = HAL_GetTick();
    while ((L0X_Rd(0x00) & 0x01) != 0) {
        if (HAL_GetTick() - start_tick > 40) break;
        osDelay(2);
    }

    uint8_t buf[2] = {0};
    uint16_t dist = 0;
    if (I2C_Lock(50)) {
        if (HAL_I2C_Mem_Read(&hi2c1, VL53L_I2C_ADDR, 0x1E, I2C_MEMADD_SIZE_8BIT, buf, 2, 50) == HAL_OK) {
            dist = ((uint16_t)buf[0] << 8) | buf[1];
        }
        uint8_t clr = 0x01;
        HAL_I2C_Mem_Write(&hi2c1, VL53L_I2C_ADDR, 0x0B, I2C_MEMADD_SIZE_8BIT, &clr, 1, 50);
        I2C_Unlock();
    }
    *p_status = (dist == 0 || dist == 8190 || dist == 8191) ? 1 : 0;
    return dist;
}
