static bool Try_Init_Sensor(void) {
    if (!I2C_Lock(100)) return false;
    HAL_StatusTypeDef dev_ready = HAL_I2C_IsDeviceReady(&hi2c1, VL53L_I2C_ADDR, 3, 50);
    I2C_Unlock();

    if (dev_ready != HAL_OK) {
        I2C_RecoverBus();
        osDelay(10);
        if (!I2C_Lock(100)) return false;
        dev_ready = HAL_I2C_IsDeviceReady(&hi2c1, VL53L_I2C_ADDR, 3, 50);
        I2C_Unlock();
        if (dev_ready != HAL_OK) {
            g_vl53_app.d_error = 10;
            g_vl53_app.sensor_ok = false;
            return false;
        }
    }

    uint8_t boot_state = 0;
    for (int i = 0; i < 20; i++) {
        VL53L1X_BootState(VL53L_I2C_ADDR, &boot_state);
        if (boot_state != 0) break;
        osDelay(10);
    }

    if (VL53L1X_SensorInit(VL53L_I2C_ADDR) != VL53L1_ERROR_NONE) {
        g_vl53_app.d_error = 20;
        g_vl53_app.sensor_ok = false;
        return false;
    }

    VL53L1X_SetDistanceMode(VL53L_I2C_ADDR, VL53L1X_DISTANCE_MODE_LONG);
    VL53L1X_SetTimingBudgetInMs(VL53L_I2C_ADDR, 50);
    VL53L1X_SetInterMeasurementInMs(VL53L_I2C_ADDR, 55);
    VL53L1X_StartRanging(VL53L_I2C_ADDR);

    g_vl53_app.sensor_ok = true;
    g_vl53_app.d_error = 0;
    return true;
}

static uint16_t Sensor_ReadDistance(uint8_t *p_status) {
    uint8_t isDataReady = 0;
    VL53L1X_CheckForDataReady(VL53L_I2C_ADDR, &isDataReady);

    static uint32_t s_last_read = 0;
    if (!isDataReady && (HAL_GetTick() - s_last_read > 80)) {
        isDataReady = 1;
    }

    uint16_t dist = 0;
    if (isDataReady) {
        s_last_read = HAL_GetTick();
        VL53L1X_GetRangeStatus(VL53L_I2C_ADDR, p_status);
        VL53L1X_GetDistance(VL53L_I2C_ADDR, &dist);
        VL53L1X_ClearInterrupt(VL53L_I2C_ADDR);
    }
    return dist;
}

