(* ============================================================================ *)
(* CHƯƠNG TRÌNH ĐỘC LẬP: TEST CC-LINK DAC AJ65VBTCU-68DAVN (TRẠM 1)             *)
(* FILE: 08_test_cclink_68davn.st                                              *)
(* ĐẶC TÍNH: 8 KÊNH ANALOG OUTPUT (-10V..+10V, NẠP 0..4000 = 0.0V..10.0V)      *)
(* ĐỊA CHỈ: RX=X1000..X101F | RY=Y1000..Y101F | RWw=W200..W20F | RWr=W100..W10F*)
(* ============================================================================ *)

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 1: NẠP THÔNG SỐ CẤU HÌNH BẮT BUỘC VÀO THANH GHI BỘ ĐỆM RWw             *)
(* ---------------------------------------------------------------------------- *)
W208 := 16#0000; (* RWw8: BẬT chuyển đổi D/A cả 8 kênh CH1..CH8 (0 = ENABLE) *)
W209 := 16#1111; (* RWw9: Dải Range CH1..CH4: 1H (0..5V, 0..4000 = 0..5V) *)
W20A := 16#1111; (* RWwA: Dải Range CH5..CH8: 1H (0..5V, 0..4000 = 0..5V) *)
W20B := 16#0000; (* RWwB: HOLD/CLEAR = 0 (CLEAR về 0.0V khi PLC dừng STOP) *)

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 2: BẮT TAY HANDSHAKE TỰ ĐỘNG CHUẨN XÁC THEO MANUAL SH-080397             *)
(* ---------------------------------------------------------------------------- *)
(* Pha 1: Tự động đáp ứng khi module đòi cấu hình ban đầu (Giải phóng kẹt X1018) *)
Y1018 := X1018;

(* Pha 2: Kích yêu cầu nạp Range Y1019 khi chưa Ready hoặc khi nhấn nút Reset M645 *)
IF (NOT X101B AND NOT X1018) OR M645 THEN
    Y1019 := TRUE;
    IF X1019 THEN
        Y1019 := FALSE; (* Module nạp xong Range -> Hạ Y1019 *)
        M645  := FALSE;
    END_IF;
ELSE
    IF X1019 THEN
        Y1019 := FALSE;
    END_IF;
END_IF;

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 3: ĐÈN BÁO TRẠNG THÁI VÀ NÚT RESET LỖI                                 *)
(* ---------------------------------------------------------------------------- *)
M641 := X101B;  (* Đèn báo Module DAC đã READY (sẵn sàng xuất áp) *)
M642 := X101A;  (* Đèn báo Cờ Lỗi Trạm 1 *)
Y101A := M648;  (* Nút bấm M648 xóa cờ lỗi *)

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 4: BẬT COIL CHO PHÉP XUẤT ÁP CẢ 8 KÊNH RA CỌC DOMINO KHI READY (X101B)  *)
(* ---------------------------------------------------------------------------- *)
Y1000 := X101B; (* CH1 Analog Output Enable *)
Y1001 := X101B; (* CH2 *)
Y1002 := X101B; (* CH3 *)
Y1003 := X101B; (* CH4 *)
Y1004 := X101B; (* CH5 *)
Y1005 := X101B; (* CH6 *)
Y1006 := X101B; (* CH7 *)
Y1007 := X101B; (* CH8 *)

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 5: TỰ ĐỘNG NẠP MẶC ĐỊNH MỨC XUẤT ÁP 10.0V (4000) ĐỂ ĐO CÓ ÁP NGAY       *)
(* ---------------------------------------------------------------------------- *)
IF D650 = 0 AND NOT M650 AND NOT M654 THEN
    D650 := 4000; D651 := 4000; D652 := 4000; D653 := 4000;
    D654 := 4000; D655 := 4000; D656 := 4000; D657 := 4000;
END_IF;

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 6: CÁC NÚT BẤM TEST NHANH 4 MỨC ĐIỆN ÁP TRÊN MONITOR / HMI             *)
(* ---------------------------------------------------------------------------- *)
IF M650 THEN (* Nút Set 0.0V *)
    D650 := 0;    D651 := 0;    D652 := 0;    D653 := 0;
    D654 := 0;    D655 := 0;    D656 := 0;    D657 := 0;
    M650 := FALSE;
END_IF;

IF M651 THEN (* Nút Set 2.5V *)
    D650 := 1000; D651 := 1000; D652 := 1000; D653 := 1000;
    D654 := 1000; D655 := 1000; D656 := 1000; D657 := 1000;
    M651 := FALSE;
END_IF;

IF M652 THEN (* Nút Set 5.0V *)
    D650 := 2000; D651 := 2000; D652 := 2000; D653 := 2000;
    D654 := 2000; D655 := 2000; D656 := 2000; D657 := 2000;
    M652 := FALSE;
END_IF;

IF M653 THEN (* Nút Set 10.0V *)
    D650 := 4000; D651 := 4000; D652 := 4000; D653 := 4000;
    D654 := 4000; D655 := 4000; D656 := 4000; D657 := 4000;
    M653 := FALSE;
END_IF;

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 7: CHẾ ĐỘ QUÉT ÁP TỰ ĐỘNG SWEEP (0V -> 10V -> 0V MỖI 100ms)             *)
(* ---------------------------------------------------------------------------- *)
IF M654 AND SM412 THEN
    IF NOT M649 THEN
        D660 := D660 + 100;
        IF D660 >= 4000 THEN D660 := 4000; M649 := TRUE; END_IF;
    ELSE
        D660 := D660 - 100;
        IF D660 <= 0 THEN D660 := 0; M649 := FALSE; END_IF;
    END_IF;
    D650 := D660; D651 := D660; D652 := D660; D653 := D660;
    D654 := D660; D655 := D660; D656 := D660; D657 := D660;
END_IF;

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 8: LIÊN TỤC GHI DỮ LIỆU SỐ VÀO THANH GHI BỘ ĐỆM RWw0..RWw7               *)
(* ---------------------------------------------------------------------------- *)
W200 := D650; (* Kênh 1: 0..4000 tương ứng 0.0V..10.0V *)
W201 := D651; (* Kênh 2 *)
W202 := D652; (* Kênh 3 *)
W203 := D653; (* Kênh 4 *)
W204 := D654; (* Kênh 5 *)
W205 := D655; (* Kênh 6 *)
W206 := D656; (* Kênh 7 *)
W207 := D657; (* Kênh 8 *)

(* ---------------------------------------------------------------------------- *)
(* BƯỚC 9: GIÁM SÁT MÃ LỖI VÀ TRẠNG THÁI                                       *)
(* ---------------------------------------------------------------------------- *)
D681 := W108;      (* RWr8: Mã lỗi của module DAC (0 = Bình thường) *)
D683 := K4X1010;   (* Monitor 16 cờ X1010..X101F (Bit 8=X1018, Bit 11=X101B Ready) *)
